generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USERS
// ============================================

model User {
  id        String    @id @default(uuid())
  authId    String?   @unique @map("auth_id")
  email     String    @unique
  name      String
  phone     String?
  birthDate DateTime? @map("birth_date") @db.Date
  role      Role      @default(CLIENT)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  orders                Order[]                      @relation("OrderUser")
  createdOrders         Order[]                      @relation("OrderCreatedBy")
  couponUsages          CouponUsage[]
  memberships           CompanyMember[]
  reviewedRegistrations CompanyRegistrationRequest[] @relation("ReviewedRegistrations")
  cartItemsAdded        CartItem[]                   @relation("CartItemAddedBy")
  supportTickets        SupportTicket[]              @relation("SupportTicketsCreated")
  supportMessages       SupportMessage[]             @relation("SupportMessagesAuthored")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  OPS_ADMIN
  FINANCE_ADMIN
  KAM
  OPERATOR
  CLIENT
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id            String   @id @default(uuid())
  nameEs        String   @map("name_es")
  nameEn        String?  @map("name_en")
  descriptionEs String?  @map("description_es")
  descriptionEn String?  @map("description_en")
  basePrice     Decimal  @map("base_price") @db.Decimal(10, 2)
  image         String?
  stock         Int?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sizes          ProductSize[]
  modifierGroups ProductModifierGroup[]
  comboItems     ComboItem[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  tags           ProductTag[]
  sectionItems   SectionItem[]

  @@map("products")
}

model ProductSize {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  nameEs        String  @map("name_es")
  nameEn        String? @map("name_en")
  descriptionEs String? @map("description_es")
  descriptionEn String? @map("description_en")
  price         Decimal @db.Decimal(10, 2)
  stock         Int?
  sortOrder     Int     @default(0) @map("sort_order")
  isDefault     Boolean @default(false) @map("is_default")
  isActive      Boolean @default(true) @map("is_active")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  cartItems          CartItem[]
  modifierSizePrices ModifierSizePrice[]

  @@map("product_sizes")
}

model ProductModifierGroup {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  nameEs        String  @map("name_es")
  nameEn        String? @map("name_en")
  descriptionEs String? @map("description_es")
  descriptionEn String? @map("description_en")
  minSelect     Int     @default(0) @map("min_select")
  maxSelect     Int     @default(1) @map("max_select")
  sortOrder     Int     @default(0) @map("sort_order")

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers ProductModifier[]

  @@map("product_modifier_groups")
}

model ProductModifier {
  id              String  @id @default(uuid())
  groupId         String  @map("group_id")
  nameEs          String  @map("name_es")
  nameEn          String? @map("name_en")
  priceAdjustment Decimal @default(0) @map("price_adj") @db.Decimal(10, 2)
  isDefault       Boolean @default(false) @map("is_default")
  isActive        Boolean @default(true) @map("is_active")
  sizeRestricted  Boolean @default(false) @map("size_restricted")
  sortOrder       Int     @default(0) @map("sort_order")

  group              ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]
  cartItemModifiers  CartItemModifier[]
  tags               ProductModifierTag[]
  sizePrices         ModifierSizePrice[]

  @@map("product_modifiers")
}

model ModifierSizePrice {
  id              String  @id @default(uuid())
  modifierId      String  @map("modifier_id")
  productSizeId   String  @map("product_size_id")
  priceAdjustment Decimal @map("price_adj") @db.Decimal(10, 2)

  modifier    ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  productSize ProductSize     @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  @@unique([modifierId, productSizeId])
  @@index([modifierId])
  @@index([productSizeId])
  @@map("modifier_size_prices")
}

// ============================================
// COMBOS
// ============================================

model Combo {
  id            String   @id @default(uuid())
  nameEs        String   @map("name_es")
  nameEn        String?  @map("name_en")
  descriptionEs String?  @map("description_es")
  descriptionEn String?  @map("description_en")
  price         Decimal  @db.Decimal(10, 2)
  image         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items        ComboItem[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  sectionItems SectionItem[]

  @@map("combos")
}

model ComboItem {
  id        String @id @default(uuid())
  comboId   String @map("combo_id")
  productId String @map("product_id")
  quantity  Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("combo_items")
}

// ============================================
// COUPONS
// ============================================

enum CouponType {
  GLOBAL
  UNIQUE
}

model Coupon {
  id              String     @id @default(uuid())
  type            CouponType
  nameEs          String     @unique @map("name_es")
  nameEn          String?    @map("name_en")
  discountPercent Decimal    @map("discount_percent") @db.Decimal(5, 2)
  maxDiscount     Decimal    @map("max_discount") @db.Decimal(10, 2)
  totalQuantity   Int        @map("total_quantity")
  usedQuantity    Int        @default(0) @map("used_quantity")
  expiresAt       DateTime   @map("expires_at")
  isActive        Boolean    @default(true) @map("is_active")
  companyId       String?    @map("company_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  company Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  usages  CouponUsage[]
  orders  Order[]

  @@index([companyId])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String   @map("coupon_id")
  userId   String   @map("user_id")
  orderId  String   @map("order_id")
  usedAt   DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, userId])
  @@unique([orderId])
  @@map("coupon_usages")
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  CREATED
  PENDING_APPROVAL
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  IN_ADJUSTMENT
  IN_PREPARATION
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  LOW
  MEDIUM
  HIGH
}

model Order {
  id                String        @id @default(uuid())
  userId            String?       @map("user_id")
  couponId          String?       @map("coupon_id")
  companyId         String        @map("company_id")
  branchId          String?       @map("branch_id")
  departmentId      String?       @map("department_id")
  createdById       String        @map("created_by_id")
  deliveryAddressId String        @map("delivery_address_id")
  deliveryDate      DateTime?     @map("delivery_date") @db.Date
  deliveryTime      String?       @map("delivery_time")
  notes             String?
  priority          OrderPriority @default(MEDIUM)
  status            OrderStatus   @default(CREATED)
  subtotal          Decimal       @default(0) @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @default(0) @db.Decimal(10, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user            User?          @relation("OrderUser", fields: [userId], references: [id])
  coupon          Coupon?        @relation(fields: [couponId], references: [id])
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch?        @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  department      Department?    @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  createdBy       User           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deliveryAddress CompanyAddress @relation(fields: [companyId, deliveryAddressId], references: [companyId, id], onDelete: Restrict)
  items           OrderItem[]
  couponUsage     CouponUsage?

  @@index([userId])
  @@index([companyId])
  @@index([createdById])
  @@index([branchId])
  @@index([departmentId])
  @@index([deliveryAddressId])
  @@map("orders")
}

// ============================================
// MULTI-TENANT (Companies, Branches, Departments, Members)
// ============================================

enum CompanyRole {
  COMPANY_ADMIN
  COMPANY_BUYER
  COMPANY_FINANCE
  COMPANY_APPROVER
}

model Company {
  id            String   @id @default(uuid())
  legalName     String   @map("legal_name")
  taxId         String   @unique @map("tax_id")
  email         String?
  phone         String?
  fiscalName    String?  @map("fiscal_name")
  fiscalAddress String?  @map("fiscal_address")
  creditDays    Int      @default(0) @map("credit_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branches            Branch[]
  departments         Department[]
  addresses           CompanyAddress[]
  members             CompanyMember[]
  orders              Order[]
  coupons             Coupon[]
  registrationRequest CompanyRegistrationRequest?
  cart                Cart?
  supportTickets      SupportTicket[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members CompanyMember[]
  orders  Order[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("branches")
}

model Department {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members CompanyMember[]
  orders  Order[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("departments")
}

model CompanyAddress {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  label      String
  line1      String
  line2      String?
  reference  String?
  city       String
  state      String?
  country    String
  zip        String?
  isBilling  Boolean  @default(false) @map("is_billing")
  isShipping Boolean  @default(true) @map("is_shipping")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("company_addresses")
}

model CompanyMember {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  companyId      String      @map("company_id")
  role           CompanyRole
  position       String?
  branchId       String?     @map("branch_id")
  departmentId   String?     @map("department_id")
  canPayInvoices Boolean     @default(false) @map("can_pay_invoices")
  isActive       Boolean     @default(true) @map("is_active")
  lastSeenAt     DateTime?   @map("last_seen_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [companyId, branchId], references: [companyId, id])
  department Department? @relation(fields: [companyId, departmentId], references: [companyId, id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@map("company_members")
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyRegistrationRequest {
  id                String                    @id @default(uuid())
  legalName         String                    @map("legal_name")
  taxId             String                    @map("tax_id")
  contactName       String                    @map("contact_name")
  contactEmail      String                    @map("contact_email")
  contactPhone      String                    @map("contact_phone")
  position          String?
  employeeCount     Int?                      @map("employee_count")
  status            RegistrationRequestStatus @default(PENDING)
  rejectionReason   String?                   @map("rejection_reason")
  reviewedAt        DateTime?                 @map("reviewed_at")
  reviewedById      String?                   @map("reviewed_by_id")
  approvedCompanyId String?                   @unique @map("approved_company_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  reviewedBy      User?    @relation("ReviewedRegistrations", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedCompany Company? @relation(fields: [approvedCompanyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([taxId])
  @@index([contactEmail])
  @@map("company_registration_requests")
}

// ============================================
// SUPPORT (tickets)
// ============================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportTicket {
  id               String       @id @default(uuid())
  ticketNumber     Int          @unique @default(autoincrement()) @map("ticket_number")
  companyId        String       @map("company_id")
  createdById      String       @map("created_by_id")
  subject          String?
  status           TicketStatus @default(OPEN)
  firstRespondedAt DateTime?    @map("first_responded_at")
  closedAt         DateTime?    @map("closed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User             @relation("SupportTicketsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  messages  SupportMessage[]

  @@index([companyId, status])
  @@index([status])
  @@index([createdById])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(uuid())
  ticketId      String   @map("ticket_id")
  authorId      String   @map("author_id")
  body          String
  attachmentUrl String?  @map("attachment_url")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("SupportMessagesAuthored", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorId])
  @@map("support_messages")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  productSizeId String? @map("product_size_id")
  comboId       String? @map("combo_id")
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize ProductSize?        @relation(fields: [productSizeId], references: [id], onDelete: Restrict)
  combo       Combo?              @relation(fields: [comboId], references: [id], onDelete: Restrict)
  modifiers   OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id              String  @id @default(uuid())
  orderItemId     String  @map("order_item_id")
  modifierId      String  @map("modifier_id")
  priceAdjustment Decimal @map("price_adj") @db.Decimal(10, 2)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@map("order_item_modifiers")
}

// ============================================
// CART (carrito persistente, uno por empresa)
// ============================================

model Cart {
  id        String   @id @default(uuid())
  companyId String   @unique @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String   @map("cart_id")
  productId     String   @map("product_id")
  productSizeId String?  @map("product_size_id")
  comboId       String?  @map("combo_id")
  quantity      Int      @default(1)
  addedById     String?  @map("added_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart        Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSize ProductSize?       @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  combo       Combo?             @relation(fields: [comboId], references: [id], onDelete: Cascade)
  addedBy     User?              @relation("CartItemAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  modifiers   CartItemModifier[]

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model CartItemModifier {
  id         String @id @default(uuid())
  cartItemId String @map("cart_item_id")
  modifierId String @map("modifier_id")

  cartItem CartItem        @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifier ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, modifierId])
  @@map("cart_item_modifiers")
}

// ============================================
// BANNERS
// ============================================

model Banner {
  id              String    @id @default(uuid())
  title           String?
  imageUrl        String?   @map("image_url")
  imageMobileUrl  String?   @map("image_mobile_url")
  altText         String    @map("alt_text")
  linkUrl         String?   @map("link_url")
  section         String    @default("home-carousel")
  order           Int       @default(0)
  backgroundColor String?   @map("background_color")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([section, isActive])
  @@map("banners")
}

// ============================================
// MOOD GALLERY
// ============================================

model MoodGallery {
  id             String   @id @default(uuid())
  title          String?
  imageUrl       String?  @map("image_url")
  imageMobileUrl String?  @map("image_mobile_url")
  altEs          String   @map("alt_es")
  altEn          String   @map("alt_en")
  section        String?  @default("mood-carousel")
  order          Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("mood_gallery")
}

// ============================================
// TAGS
// ============================================

model Tag {
  id        String   @id @default(uuid())
  nameEs    String   @unique @map("name_es")
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products  ProductTag[]
  modifiers ProductModifierTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductModifierTag {
  modifierId String @map("modifier_id")
  tagId      String @map("tag_id")

  modifier ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  tag      Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modifierId, tagId])
  @@map("product_modifier_tags")
}

// ============================================
// AGENCY CARDS
// ============================================

model AgencyCard {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String?  @map("image_url")
  location     String   @map("location")
  lodgingType  String   @map("lodging_type")
  distance     String?  @map("distance")
  email        String?
  phone        String?
  socialHandle String?  @map("social_handle")
  facebookUrl  String?  @map("facebook_url")
  instagramUrl String?  @map("instagram_url")
  tiktokUrl    String?  @map("tiktok_url")
  order        Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("agency_cards")
}

// ============================================
// SECTIONS
// ============================================

model Section {
  id        String   @id @default(uuid())
  nameEs    String   @map("name_es")
  nameEn    String?  @map("name_en")
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items SectionItem[]

  @@map("sections")
}

model SectionItem {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  productId String? @map("product_id")
  comboId   String? @map("combo_id")
  order     Int     @default(0)

  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  combo   Combo?   @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@unique([sectionId, comboId])
  @@map("section_items")
}
