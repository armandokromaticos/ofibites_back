# Algunas plataformas de deploy (Render) corren "yarn install" con
# NODE_ENV=production activo, y Yarn Classic bajo ese modo omite
# devDependencies de forma selectiva/inconsistente (nest build, @types/node
# y @types/jest no se instalaban, pero prisma y typescript sí quedaban).
# Esto fuerza a instalar siempre todo el árbol, sin importar NODE_ENV.
production false
